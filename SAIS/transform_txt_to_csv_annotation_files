import os
import pandas as pd


def _infer_subject(video_name):
    # Example: Suturing_B001 -> Subject02 (B->2), Knot_Tying_H005 -> Subject08
    token = video_name.split('_')[-1]
    letter = token[0]
    if 'A' <= letter <= 'Z':
        subject_num = ord(letter) - ord('A') + 1
        return f'Subject{subject_num:02d}'
    return 'Subject00'


def _infer_supertrial(video_name):
    # Example: Suturing_B001 -> Trial001
    token = video_name.split('_')[-1]
    digits = ''.join(ch for ch in token if ch.isdigit())
    if digits:
        return f'Trial{int(digits):03d}'
    return 'Trial000'


def generate_jigsaws_loader_csv(dataset_root, output_csv):
    """Generate SurgicalPaths/JIGSAWS_Suturing_gestures_timestamps.csv.

    Output schema keeps loader-compatible columns and adds boundaries:
    id, Path, Gesture, Subject, SuperTrial, StartFrame, EndFrame
    """
    print(f'Generating CSV annotation file from JIGSAWS transcriptions: {output_csv}...')
    print(f'Looking for transcriptions under {dataset_root}...')
    transcription_dirs = [
        os.path.join(dataset_root, 'Knot_Tying', 'Knot_Tying', 'transcriptions'),
        os.path.join(dataset_root, 'Needle_Passing', 'Needle_Passing', 'transcriptions'),
        os.path.join(dataset_root, 'Suturing', 'Suturing', 'transcriptions'),
    ]

    rows = []
    row_id = 1

    for transcription_dir in transcription_dirs:
        if not os.path.isdir(transcription_dir):
            print(f'Skipping missing directory: {transcription_dir}')
            continue

        for file_name in sorted(os.listdir(transcription_dir)):
            if not file_name.endswith('.txt'):
                continue

            video_name = os.path.splitext(file_name)[0]
            print(f'Processing {video_name} from {transcription_dir}...')
            task_name = os.path.basename(os.path.dirname(transcription_dir))
            video_path = os.path.join('SAIS', 'videos', f'{video_name}.mp4')
            # Keep backslashes so current loader parsing remains compatible.
            video_path = video_path.replace('/', '\\')
            print(f'Expected video path: {video_path}')
            annotation_file = os.path.join(transcription_dir, file_name)
            with open(annotation_file, 'r') as handle:
                for line in handle:
                    parts = line.strip().split()
                    if len(parts) < 3:
                        continue

                    start_frame = int(parts[0])
                    end_frame = int(parts[1])
                    gesture = parts[2].strip()
                    rows.append(
                        {
                            'id': row_id,
                            'Path': video_path,
                            'Gesture': gesture,
                            'Subject': _infer_subject(video_name),
                            'SuperTrial': _infer_supertrial(video_name),
                            'StartFrame': start_frame,
                            'EndFrame': end_frame,
                        }
                    )
                    row_id += 1

    df = pd.DataFrame(
        rows,
        columns=['id', 'Path', 'Gesture', 'Subject', 'SuperTrial', 'StartFrame', 'EndFrame']
    )
    os.makedirs(os.path.dirname(output_csv), exist_ok=True)
    df.to_csv(output_csv, index=False)
    print(f'Saved {len(df)} rows to {output_csv}')
    return df


if __name__ == '__main__':
    dataset_root = './SAIS/datasets/jigsaw'
    # output_csv = './SAIS/SAIS/SurgicalPaths/JIGSAWS_Suturing_gestures_timestamps.csv'
    output_csv = './SAIS/paths/JIGSAWS_Suturing_gestures_timestamps.csv'
    # /SAIS/paths\\JIGSAWS_Suturing_FlowPaths.csv
    generate_jigsaws_loader_csv(dataset_root, output_csv)